# Web app (apps/web) — also copy relevant vars to apps/web/.env
SITE_URL=http://localhost:3000
VITE_API_BASE_URL=http://localhost:3001

# Authenticated Workspace (Auth0 SPA)
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=

# Backend Auth0 JWT validation
# AUTH_ISSUER_URL — URL completa com https:// (barra final ok; o backend normaliza)
# AUTH_JWKS_URL   — URL completa com https://
# AUTH_AUDIENCE   — Identifier da API no Auth0 (igual VITE_AUTH0_AUDIENCE), não é URL do backend local
AUTH_ISSUER_URL=https://your-tenant.us.auth0.com/
AUTH_AUDIENCE=https://api.cultiv.app
AUTH_JWKS_URL=https://your-tenant.us.auth0.com/.well-known/jwks.json

# Auth0 Management API (M2M) — exigido pela exclusão de conta (LGPD): sem estas vars o evento
# account.auth0-delete fica em retry infinito no outbox e a identidade nunca é apagada no Auth0.
AUTH0_MANAGEMENT_DOMAIN=your-tenant.us.auth0.com
AUTH0_MANAGEMENT_CLIENT_ID=
AUTH0_MANAGEMENT_CLIENT_SECRET=
AUTH0_MANAGEMENT_AUDIENCE=https://your-tenant.us.auth0.com/api/v2/

# Backend runtime (3001 avoids clashing with web dev on 3000)
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
CORS_ALLOWED_ORIGINS=http://localhost:3000
SERVICE_NAME=backend
APP_VERSION=0.1.0
EXECUTION_MODE=async
QUALITY_MODE=balanced
DEFAULT_LANGUAGE=pt-BR

# PostgreSQL + Redis (required for durable runtime in development)
#   docker compose up postgres redis
DATABASE_URL=postgresql://contentlib:contentlib@localhost:5432/contentlib
REDIS_URL=redis://localhost:6379
# Local dev only — allows in-memory runtime without PG/Redis (forbidden when NODE_ENV=production)
BACKEND_ALLOW_IN_MEMORY_RUNTIME=true
# Production-only (backend refuses boot without these when NODE_ENV=production):
# CORS_ALLOWED_ORIGINS=https://www.cultiv.app
# VOICE_DATA_PROTECTION_KEY=<32+ random chars — openssl rand -base64 32>
# VOICE_DATA_PROTECTION_KEY_PREVIOUS=<old key during rotation only; remove after rotate-voice-key>
# Rotation CLI flags: --dry-run, --encrypt-plaintext (legacy rows without voiceprot:v1:)
# Trust X-Forwarded-For / X-Real-IP for rate limiting (defaults to true in production)
BACKEND_TRUST_PROXY=
EXECUTION_WORKER_CONCURRENCY=2
BACKEND_TEST_DATABASE_URL=postgresql://contentlib:contentlib@localhost:5432/contentlib
BACKEND_TEST_REDIS_URL=redis://localhost:6379
RUN_POSTGRES_TESTS=false
# Use `pnpm test:durable` (sets VITEST_DURABLE_SUITE=true) — not enabled in default `pnpm test`
RUN_POSTGRES_TESTS=false

# Product defaults
BILLING_USER_ID=
BILLING_PLAN_ID=

# Payment gateways (optional until billing checkout is enabled)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
BILLING_CHECKOUT_SUCCESS_URL=http://localhost:3000/app/plans?status=success
BILLING_CHECKOUT_CANCEL_URL=http://localhost:3000/app/plans?status=cancel

AI_POLICY_MANIFEST_PATH=
AI_POLICY_ATTACHED_VERSION=
EXPERIMENTAL_AI_POLICY_MANIFEST_PATH=
EXPERIMENTAL_DEBUG_ENABLED=false
AI_POLICY_RELOAD_INTERVAL_MS=

# Author Reasoning Signature (off by default — see ADR 0006)
VOICE_REASONING_SIGNATURE_V1=false

# Generation Compositor v1 (off by default — enable for parity / rollout)
COMPOSITOR_V1_ENABLED=false

# Provider configuration
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_VERSION=
GEMINI_API_KEY=
GEMINI_BASE_URL=
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
