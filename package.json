{
  "name": "cultiv",
  "version": "0.1.0",
  "private": true,
  "description": "Cultiv monorepo — web, backend, packages",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "build:web": "pnpm --filter @my-ai-orchestrator/web build",
    "build:backend": "pnpm --filter @my-ai-orchestrator/backend build",
    "dev:backend": "pnpm --filter @my-ai-orchestrator/backend dev",
    "dev:web": "pnpm --filter @my-ai-orchestrator/web dev",
    "server": "pnpm --filter @my-ai-orchestrator/backend dev",
    "showcase:generate": "tsx scripts/generate-showcase-sample.ts",
    "showcase:voice-setup": "tsx scripts/showcase-voice-setup.ts",
    "billing:activate": "pnpm --filter @my-ai-orchestrator/backend billing:activate",
    "test": "vitest run",
    "test:ci": "vitest run --exclude '**/durable-runtime.integration.test.ts' --exclude '**/billing-postgres-persistence.test.ts'",
    "test:ci:backend": "vitest run --exclude '**/durable-runtime.integration.test.ts' --exclude '**/billing-postgres-persistence.test.ts' --exclude 'tests/web/**' --exclude 'tests/governance/frontend-client-boundary.test.ts'",
    "test:ci:web": "vitest run tests/web tests/governance/frontend-client-boundary.test.ts",
    "test:web": "vitest run tests/web tests/governance/frontend-client-boundary.test.ts",
    "test:integration": "pnpm test:postgres",
    "test:postgres": "node scripts/run-postgres-tests.mjs",
    "test:durable": "node scripts/run-durable-runtime-tests.mjs",
    "hitl:durable-smoke": "tsx scripts/hitl-durable-smoke.ts",
    "eval:reasoning": "tsx scripts/eval-reasoning.ts",
    "eval:development": "tsx scripts/eval-development.ts",
    "smoke": "vitest run tests/governance/monorepo-governance.test.ts",
    "guardrails:effect": "vitest run tests/governance/effect-hardening-governance.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "pnpm -r --if-present lint"
  },
  "devDependencies": {
    "@my-ai-orchestrator/ai-adapters": "workspace:*",
    "@my-ai-orchestrator/backend": "workspace:*",
    "@my-ai-orchestrator/client-sdk": "workspace:*",
    "@my-ai-orchestrator/contracts": "workspace:*",
    "@my-ai-orchestrator/core": "workspace:*",
    "@my-ai-orchestrator/database": "workspace:*",
    "@my-ai-orchestrator/domain": "workspace:*",
    "@my-ai-orchestrator/feature-flags": "workspace:*",
    "@my-ai-orchestrator/orchestrator": "workspace:*",
    "@my-ai-orchestrator/payments": "workspace:*",
    "@my-ai-orchestrator/skills": "workspace:*",
    "@my-ai-orchestrator/text-quality": "workspace:*",
    "@types/node": "^22.5.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^6.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "dotenv": "^17.4.2",
    "effect": "^3.21.2",
    "ioredis": "^5.6.1",
    "tsx": "^4.7.0",
    "typescript": "^5.8.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.3.0"
}
