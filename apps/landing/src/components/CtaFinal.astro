---
// CTA final (Ato 8) — design 698–705. Last conversion moment: one
// promise line (Instrument Serif, display) + one acid button, nothing else
// competes in the fold (CTA-FOOTER-SPEC §1/§5.1). Cor: claro (locked in
// spec — the dark chambers are reserved for constellation/founder proof).
//
// Binding exception: the design's href is the raw
// `https://auth.cultiv.app/signup?returnTo=%2Fcalibracao` — v5 contract
// requires every trial CTA to go through `src/config.ts`'s `trialUrl`
// instead (same Auth0 destination, single source of truth).
import T from "./T.astro";
import { trialUrl } from "../config";
import "../styles/closing.css";
---

<section id="cta-final" aria-label="Comece agora" class="cta-final">
  <div class="cta-final__inner" data-close-reveal>
    <h2 class="cta-final__title">
      <T
        pt="A sua voz não devia sumir só porque você precisa publicar mais."
        en="Your voice shouldn't disappear just because you need to publish more."
      />
    </h2>
    <div class="cta-final__row">
      <a class="cta-final__btn" href={trialUrl}>
        <T pt="Comece o teste grátis →" en="Start the free trial →" />
      </a>
    </div>
  </div>
</section>

<script>
  import { initCloseReveal } from "../scripts/closing";
  initCloseReveal();
</script>
