---
// Persistent nav — design 179–193, ported markup/visuals exactly, with two
// binding-contract deviations: (1) the CTA is "Começar grátis →" → trialUrl
// instead of the design's "Testar a demo →" (that CTA stays inside the Hero
// section itself, scrolling to #demo — this nav's job is conversion, not
// wayfinding); (2) a pt·en language pill sits between brand and CTA (design
// is pt-only; language toggle is a user-decided addition, see §i18n).
//
// State (background/blur/hairline, intro visibility) is driven by
// `html[data-scrolled]`/`html[data-intro]`, normally written by HeroStory's
// script (contract: "hero sets it"). This component also runs its own tiny
// scroll listener for the same `data-scrolled` threshold (sy>24, matching
// the design) so the nav still opacifies correctly on pages with no Hero —
// /termos, /privacidade, /404 — which import this same Nav. Both listeners
// compute the identical boolean, so the redundancy on the v5 home page is
// harmless.
import T from "./T.astro";
import { trialUrl } from "../config";
---

<nav class="v5nav" aria-label="Principal">
  <a class="v5nav__brand" href="/" aria-label="Cultiv — início">
    <svg
      data-cultiv-nav-brand="true"
      class="v5nav__mark"
      width="28"
      height="28"
      viewBox="0 0 96 96"
      fill="none"
      aria-hidden="true"
    >
      <defs>
        <path
          id="navQ"
          d="M62 38c0-9.5-7-16-15.5-16C38 22 32 28.2 32 36.2c0 7.9 6 13.8 14 13.8 1.1 0 2.2-.1 3.2-.4C48 60 42.2 65.6 34.6 68.2l3.4 6.8C50.6 70.6 62 59.6 62 43.6Z"
        ></path>
      </defs>
      <circle class="v5nav__ring" cx="48" cy="48" r="37" stroke-width="5"></circle>
      <path d="M54.4 11.6A37 37 0 0 1 78.3 26.8" stroke="#95CB3E" stroke-width="5"></path>
      <use class="v5nav__q" href="#navQ" transform="translate(26.5 31.6) scale(0.62) translate(-32 -22)"></use>
      <use class="v5nav__q" href="#navQ" transform="translate(51 31.6) scale(0.62) translate(-32 -22)"></use>
    </svg>
    <span class="v5nav__word">Cultiv</span>
  </a>

  <button type="button" class="v5nav__lang" data-lang-toggle aria-label="Switch to English">
    <span data-lang-label="pt" aria-hidden="true">pt</span>
    <span aria-hidden="true"> · </span>
    <span data-lang-label="en" aria-hidden="true">en</span>
  </button>

  <a class="v5nav__cta" href={trialUrl}>
    <T pt="Começar grátis →" en="Start free →" />
  </a>
</nav>

<style>
  .v5nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px clamp(16px, 4vw, 40px);
    background: transparent;
    box-shadow: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    opacity: 1;
    transition:
      background-color 0.35s ease,
      box-shadow 0.35s ease,
      opacity 0.7s ease;
  }
  :global(html[data-scrolled]) .v5nav {
    background: var(--t-navbg, rgba(248, 247, 244, 0.88));
    box-shadow: 0 1px 0 var(--t-line, rgba(52, 50, 46, 0.08));
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  /* Nav hides for the intro's "draw" phase (the pinned intro logo is the
     only mark on screen); it's already back for "reveal"/"done". */
  :global(html[data-intro="draw"]) .v5nav {
    opacity: 0;
  }

  .v5nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--t-ink, #34322e);
  }
  .v5nav__mark { display: block; }
  .v5nav__ring { stroke: var(--t-logoink, #151515); }
  .v5nav__q { fill: var(--t-logoink, #151515); }
  .v5nav__word {
    font-family: var(--font-ui);
    font-weight: 560;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
  }

  .v5nav__lang {
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--t-muted, #6b675f);
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
    margin-inline-start: auto;
    margin-inline-end: clamp(14px, 2.4vw, 22px);
  }
  .v5nav__lang [data-lang-label] {
    opacity: 0.45;
    transition: opacity 0.2s ease;
  }
  :global(html:not([data-lang="en"])) .v5nav__lang [data-lang-label="pt"],
  :global(html[data-lang="en"]) .v5nav__lang [data-lang-label="en"] {
    opacity: 1;
    color: var(--t-ink, #34322e);
  }
  /* Script-only control — a toggle that does nothing without JS is dead UI;
     same doctrine as the interim nav's theme/lang tools. */
  :global(html:not(.js)) .v5nav__lang { display: none; }

  .v5nav__cta {
    font-family: inherit;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--t-bg, #f8f7f4);
    background: var(--t-ink, #34322e);
    border: none;
    border-radius: 10px;
    padding: 10px 18px;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      transform 0.15s ease;
  }
  .v5nav__cta:hover {
    background: var(--accent);
    color: var(--on-accent);
  }
  .v5nav__cta:active { transform: translateY(1px); }

  @media (max-width: 480px) {
    .v5nav__lang { margin-inline-end: 12px; }
    .v5nav__cta { padding: 10px 14px; font-size: 0.88rem; }
  }
</style>

<script>
  import { getLang, setLang, onLangChange } from "../scripts/i18n";

  const setScrolled = () => {
    const sy = window.scrollY || document.documentElement.scrollTop || 0;
    document.documentElement.toggleAttribute("data-scrolled", sy > 24);
  };
  setScrolled();
  window.addEventListener("scroll", setScrolled, { passive: true });

  const langBtn = document.querySelector<HTMLButtonElement>("[data-lang-toggle]");
  if (langBtn) {
    const sync = () => {
      const en = getLang() === "en";
      langBtn.setAttribute("aria-label", en ? "Mudar para português" : "Switch to English");
    };
    sync();
    langBtn.addEventListener("click", () => setLang(getLang() === "en" ? "pt" : "en"));
    onLangChange(sync);
  }
</script>
