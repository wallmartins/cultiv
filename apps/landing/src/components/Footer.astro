---
import T from "./T.astro";
import "../styles/closing.css";
---

<footer aria-label="Rodapé" class="footer-v5">
  <div class="footer-v5__inner" data-close-reveal>
    <p class="footer-v5__belief">
      <T pt="A sua voz não é um estilo. É como você pensa." en="Your voice isn't a style. It's how you think." />
    </p>

    <div class="footer-v5__hr" />

    <div class="footer-v5__grid">
      <div class="footer-v5__brand">
        <div class="footer-v5__logo">
          <svg
            width="26"
            height="26"
            viewBox="0 0 96 96"
            fill="none"
            aria-hidden="true"
            class="footer-v5__mark"
          >
            <defs>
              <path
                id="footerQ"
                d="M62 38c0-9.5-7-16-15.5-16C38 22 32 28.2 32 36.2c0 7.9 6 13.8 14 13.8 1.1 0 2.2-.1 3.2-.4C48 60 42.2 65.6 34.6 68.2l3.4 6.8C50.6 70.6 62 59.6 62 43.6Z"
              ></path>
            </defs>
            <circle cx="48" cy="48" r="37" stroke="currentColor" stroke-width="5" transform="rotate(-52 48 48)"
            ></circle>
            <path
              d="M54.4 11.6A37 37 0 0 1 78.3 26.8"
              stroke="oklch(0.83 0.19 128)"
              stroke-width="5"
              stroke-linecap="round"
            ></path>
            <use href="#footerQ" transform="translate(26.5 31.6) scale(0.62) translate(-32 -22)" fill="currentColor"
            ></use>
            <use href="#footerQ" transform="translate(51 31.6) scale(0.62) translate(-32 -22)" fill="currentColor"
            ></use>
          </svg>
          <span class="footer-v5__wordmark">Cultiv</span>
        </div>
        <p class="footer-v5__tag">
          <T pt="Escreve como você pensa." en="Writes the way you think." />
        </p>
      </div>

      <nav aria-label="Produto" class="footer-v5__col">
        <span class="footer-v5__label"><T pt="Produto" en="Product" /></span>
        <ul class="footer-v5__list">
          <li><a href="#demo"><T pt="Demo" en="Demo" /></a></li>
          <li><a href="#constelacao"><T pt="Mapa da voz" en="Voice map" /></a></li>
          <li><a href="#planos"><T pt="Planos" en="Plans" /></a></li>
        </ul>
      </nav>

      <nav aria-label="Legal" class="footer-v5__col">
        <span class="footer-v5__label"><T pt="Legal" en="Legal" /></span>
        <ul class="footer-v5__list">
          <li><a href="/privacidade"><T pt="Privacidade" en="Privacy" /></a></li>
          <li><a href="/termos"><T pt="Termos" en="Terms" /></a></li>
          <li><a href="mailto:contato@cultiv.app"><T pt="Falar com a gente" en="Get in touch" /></a></li>
        </ul>
      </nav>

      <nav aria-label="Redes" class="footer-v5__col">
        <span class="footer-v5__label"><T pt="Redes" en="Social" /></span>
        <div class="footer-v5__social">
          <a href="#" aria-label="Instagram" class="footer-v5__icon">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="5"></rect>
              <circle cx="12" cy="12" r="4"></circle>
              <circle cx="17.5" cy="6.5" r="1.1" fill="currentColor" stroke="none"></circle>
            </svg>
          </a>
          <a href="#" aria-label="X" class="footer-v5__icon">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.65l-5.21-6.82-5.96 6.82H1.68l7.73-8.84L1.25 2.25h6.82l4.71 6.23 5.46-6.23Zm-1.16 17.52h1.83L7.01 4.13H5.05l12.03 15.64Z"></path>
            </svg>
          </a>
          <a href="#" aria-label="LinkedIn" class="footer-v5__icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.55V9h3.57v11.45ZM22.22 0H1.77C.8 0 0 .78 0 1.75v20.5C0 23.22.8 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.75V1.75C24 .78 23.2 0 22.22 0Z"></path>
            </svg>
          </a>
        </div>
      </nav>
    </div>

    <div class="footer-v5__hr footer-v5__hr--base" />

    <div class="footer-v5__base">
      <span>© 2026 Cultiv</span>
      <span class="footer-v5__share">
        <T
          pt="Manda pra quem largou a IA porque “não soava como ele”."
          en="Send it to whoever gave up on AI because “it didn’t sound like them.”"
        />
      </span>
    </div>
  </div>
</footer>

<script>
  import { initCloseReveal } from "../scripts/closing";
  initCloseReveal();
</script>
