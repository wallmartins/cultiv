---
// Cortina de abertura: a marca se desenha e voa até a coluna de identidade.
// Fases dirigidas por scripts/constellation/intro.ts via data-curtain
// (draw → exit → settle → done). Nunca aparece sem JS ou com
// prefers-reduced-motion (CSS).
---

<div class="curtain" data-curtain="draw" aria-hidden="true">
  <div class="curtain-bg" data-curtain-bg></div>
  <div class="curtain-logo" data-curtain-logo>
    <svg viewBox="0 0 96 96" fill="none">
      <defs
        ><path
          id="q-curtain"
          d="M62 38c0-9.5-7-16-15.5-16C38 22 32 28.2 32 36.2c0 7.9 6 13.8 14 13.8 1.1 0 2.2-.1 3.2-.4C48 60 42.2 65.6 34.6 68.2l3.4 6.8C50.6 70.6 62 59.6 62 43.6Z"
        ></path></defs
      >
      <circle
        cx="48"
        cy="48"
        r="37"
        stroke="currentColor"
        stroke-width="2"
        stroke-dasharray="233"
        stroke-dashoffset="233"
        transform="rotate(-52 48 48)"
        class="draw-circle"></circle>
      <path
        d="M54.4 11.6A37 37 0 0 1 78.3 26.8"
        stroke="var(--accent)"
        stroke-width="2"
        stroke-linecap="round"
        stroke-dasharray="60"
        stroke-dashoffset="60"
        class="draw-arc"></path>
      <use
        href="#q-curtain"
        transform="translate(26.5 31.6) scale(0.62) translate(-32 -22)"
        fill="currentColor"
        class="fade-q1"></use>
      <use
        href="#q-curtain"
        transform="translate(51 31.6) scale(0.62) translate(-32 -22)"
        fill="currentColor"
        class="fade-q2"></use>
    </svg>
  </div>
</div>
