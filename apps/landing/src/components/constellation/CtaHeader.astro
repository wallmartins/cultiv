---
// CTAs de conversão do topo. Links reais (funcionam sem JS); o script
// intercepta "Experimentar Demo" para abrir o overlay sem navegar.
import { loginUrl } from "../../config";
---

<header class="ctas">
  <a class="btn ghost" href={loginUrl}>Entrar na Plataforma</a>
  <a class="btn solid" href="/demo" data-open-demo
    >Experimentar Demo <span aria-hidden="true">→</span></a
  >
</header>
