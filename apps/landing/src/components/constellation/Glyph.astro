---
// Marca Cultiv (anel + aspas duplas) — mesma geometria do design v3.
// `uid` diferencia os <defs> quando o glifo aparece mais de uma vez na página.
interface Props {
  uid: string;
  strokeWidth?: number;
  class?: string;
}
const { uid, strokeWidth = 2, class: cls } = Astro.props;
const q =
  "M62 38c0-9.5-7-16-15.5-16C38 22 32 28.2 32 36.2c0 7.9 6 13.8 14 13.8 1.1 0 2.2-.1 3.2-.4C48 60 42.2 65.6 34.6 68.2l3.4 6.8C50.6 70.6 62 59.6 62 43.6Z";
---

<svg viewBox="0 0 96 96" fill="none" aria-hidden="true" class={cls}>
  <defs><path id={`q-${uid}`} d={q}></path></defs>
  <circle cx="48" cy="48" r="37" stroke="currentColor" stroke-width={strokeWidth}></circle>
  <path
    d="M54.4 11.6A37 37 0 0 1 78.3 26.8"
    stroke="var(--accent)"
    stroke-width={strokeWidth}
    stroke-linecap="round"></path>
  <use
    href={`#q-${uid}`}
    transform="translate(26.5 31.6) scale(0.62) translate(-32 -22)"
    fill="currentColor"></use>
  <use
    href={`#q-${uid}`}
    transform="translate(51 31.6) scale(0.62) translate(-32 -22)"
    fill="currentColor"></use>
</svg>
