---
// Conteúdo do painel de UM nó: categoria, título, o quê/como, conexões
// (chips-link reais) e CTA. Usado duas vezes: renderizado aberto nas páginas
// /:slug e dentro de um <template> por nó — o script clona o template ao
// navegar, então a marcação tem UMA fonte e os estilos sempre se aplicam.
import { connectionsOf, type ConstellationNode } from "../../data/constellation";

interface Props {
  node: ConstellationNode;
}
const { node } = Astro.props;
const conns = connectionsOf(node.id);
---

<div class="panel-top">
  <span class="kicker">{node.cat}</span>
  <a class="close" href="/" data-close-panel aria-label="Fechar painel">×</a>
</div>
<h2>{node.label}</h2>
<p class="panel-what">{node.what}</p>
<h3 class="panel-h mono">Como funciona</h3>
<p class="panel-how">{node.how}</p>
<h3 class="panel-h mono">Conexões</h3>
<div class="panel-conns">
  {
    conns.map((c) => (
      <a class="chip" href={`/${c.slug}`} data-node-link={c.id}>
        {c.label}
      </a>
    ))
  }
</div>
{
  node.cta && (
    <a
      class="btn solid wide panel-cta"
      href={node.cta.target === "planos" ? "/planos" : "/demo"}
      data-panel-cta
    >
      {node.cta.label}
    </a>
  )
}
