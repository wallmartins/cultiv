---
// Uma estrela da constelação: link real para a página do nó, decorada com
// anéis/halo/órbita conforme o tipo. Estados (hover/seleção/dim) são classes
// aplicadas pelo script; aqui só o estado inicial server-rendered.
import type { ConstellationNode } from "../../data/constellation";

interface Props {
  node: ConstellationNode;
  /** Índice na lista — alimenta os ritmos de twinkle/órbita. */
  index: number;
  /** Nó selecionado no HTML inicial (páginas /:slug). */
  selected?: boolean;
  /** Relacionado ao selecionado inicial (mantém o rótulo visível no mobile). */
  related?: boolean;
}
const { node: n, index: i, selected = false, related = false } = Astro.props;

const KIND_CLASS: Record<string, string> = {
  hub: "k-hub",
  know: "k-know",
  proc: "k-proc",
  gate: "k-gate",
};
// Nós da cauda cujo rótulo vai para o lado direito no mobile (a cauda desce
// em diagonal — rótulos centralizados invadiriam o nó seguinte).
const SIDE_LABEL = new Set([
  "motor",
  "refinamento",
  "texto",
  "briefing",
  "intencao",
  "raciocinio",
  "argumentacao",
]);

const vars = [
  `--x:${(n.x / 6).toFixed(3)}%`,
  `--y:${(n.y / 8).toFixed(3)}%`,
  ...(n.mx != null ? [`--mx:${(n.mx / 6).toFixed(3)}%`, `--my:${(n.my! / 8).toFixed(3)}%`] : []),
  `--tw-dur:${(3.2 + (i % 5) * 0.8).toFixed(1)}s`,
  `--tw-delay:${(i * 0.53).toFixed(2)}s`,
  `--orbit-dur:${14 + (i % 4) * 3}s`,
].join("; ");
---

<a
  href={`/${n.slug}`}
  class:list={[
    "node",
    KIND_CLASS[n.kind],
    {
      "side-lbl": SIDE_LABEL.has(n.id),
      "is-sel": selected,
      "is-active": selected,
      "is-rel": related,
    },
  ]}
  data-node={n.id}
  aria-label={`Explorar ${n.label}`}
  style={vars}
>
  <span class="orb" aria-hidden="true">
    <span class="ambient"></span>
    <span class="ring2"></span>
    <span class="ring1"></span>
    {
      n.kind === "proc" && (
        <span class="orbit">
          <span class="orbit-dot" />
        </span>
      )
    }
    <span class="core"></span>
  </span>
  <span class="lbl">{n.label}</span>
</a>
