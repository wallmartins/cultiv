---
// Conteúdo semântico completo da constelação, em HTML puro.
// É o que crawlers de busca e de IA (GPTBot, ClaudeBot, PerplexityBot…)
// leem sem executar JavaScript: definições, listas, preços e o grafo de
// links internos entre as páginas por nó. Com JS ativo fica oculto — a
// mesma informação vive na constelação interativa.
import { NODES, PLANS, SITE, connectionsOf } from "../../data/constellation";
import { planUrl, trialUrl, loginUrl } from "../../config";

const CATS = ["Perfil de Voz", "Geração", "Jornada"] as const;
---

<section class="doc" aria-label="Cultiv em detalhe">
  <div class="wrap">
    <h2>O que é a Cultiv?</h2>
    <p>{SITE.description}</p>
    <p>
      Diferente de assistentes de escrita genéricos, a Cultiv parte de um
      <a href="/perfil-de-voz">Perfil de Voz</a> — um modelo vivo da sua forma
      de escrever — e nenhum texto é gerado sem consultá-lo. O resultado não é
      um texto de IA: é a sua autenticidade, em escala.
    </p>

    {
      CATS.map((cat) => (
        <section>
          <h3>{cat}</h3>
          {NODES.filter((n) => n.cat === cat).map((n) => (
            <article>
              <h4>
                <a href={`/${n.slug}`}>{n.label}</a>
              </h4>
              <p>{n.what}</p>
              <p>
                <strong>Como funciona:</strong> {n.how}
              </p>
              <p class="conns">
                Conecta-se a:{" "}
                {connectionsOf(n.id).map((c, i) => (
                  <>
                    {i > 0 && " · "}
                    <a href={`/${c.slug}`}>{c.label}</a>
                  </>
                ))}
              </p>
            </article>
          ))}
        </section>
      ))
    }

    <section>
      <h3>Planos e preços</h3>
      <p>
        Todos os planos incluem o Perfil de Voz completo, suporte e
        atualizações. Mude de plano quando quiser.
      </p>
      <ul>
        {
          PLANS.map((p) => (
            <li>
              <strong>{p.name}</strong> — {p.price}
              {p.per}. {p.tag} Inclui: {p.features.join(", ")}.{" "}
              <a href={planUrl(p.id, "monthly")}>{p.btn}</a>
            </li>
          ))
        }
      </ul>
    </section>

    <footer>
      <p>
        <a href={trialUrl}>Criar meu Perfil de Voz</a> ·{" "}
        <a href={loginUrl}>Entrar na Plataforma</a> ·{" "}
        <a href="/demo">Demo</a> · <a href="/planos">Planos</a>
      </p>
      <p>
        <a href="/termos">Termos de Uso</a> ·{" "}
        <a href="/privacidade">Política de Privacidade</a>
      </p>
    </footer>
  </div>
</section>

<style>
  /* Visível apenas quando não há JS (crawlers, leitores sem script). */
  :global(html.js) .doc {
    display: none;
  }
  .doc {
    background: var(--bg);
    color: var(--ink);
    border-top: 1px solid var(--line);
  }
  .wrap {
    max-width: 68ch;
    margin: 0 auto;
    padding: 48px 24px 64px;
  }
  h2,
  h3,
  h4 {
    letter-spacing: 0;
    line-height: 1.2;
  }
  h2 {
    font-family: var(--font-headline);
    font-weight: 400;
    font-size: 2rem;
  }
  h3,
  h4 {
    font-family: var(--font-ui);
    font-weight: 600;
  }
  h3 {
    font-size: 1.2rem;
    margin-top: 2.5em;
    border-bottom: 1px solid var(--line);
    padding-bottom: 8px;
  }
  article {
    margin: 1.6em 0;
  }
  a {
    color: inherit;
    text-decoration-color: var(--accent);
    text-underline-offset: 3px;
  }
  .conns {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.8rem;
    color: var(--muted);
  }
  footer {
    margin-top: 3em;
    border-top: 1px solid var(--line);
    padding-top: 16px;
    font-size: 0.9rem;
    color: var(--muted);
  }
</style>
