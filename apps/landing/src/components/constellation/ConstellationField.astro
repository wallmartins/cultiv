---
// O mapa celeste: poeira, arestas SVG e uma NodeStar por conceito, com a
// legenda. Overlays (Demo/Planos) entram pelo slot — compartilham o mesmo
// plano de empilhamento do campo.
import NodeStar from "./NodeStar.astro";
import {
  NODES,
  EDGES,
  connectionsOf,
  nodeById,
  type ConstellationNode,
} from "../../data/constellation";

interface Props {
  initial?: ConstellationNode;
}
const { initial } = Astro.props;
const initialConns = initial ? connectionsOf(initial.id) : [];
const isRelated = (id: string) =>
  !!initial && (initial.id === id || initialConns.some((c) => c.id === id));

const DUST = [
  { x: 90, y: 120, r: 1.3, accent: false, o: 0.3, dur: 6, delay: 0.4 },
  { x: 530, y: 90, r: 1, accent: true, o: 0.3, dur: 7, delay: 1.2 },
  { x: 60, y: 470, r: 1, accent: false, o: 0.25, dur: 6.5, delay: 2 },
  { x: 555, y: 640, r: 1.2, accent: false, o: 0.25, dur: 7.5, delay: 0.8 },
  { x: 480, y: 740, r: 1, accent: true, o: 0.3, dur: 6.2, delay: 1.6 },
  { x: 150, y: 600, r: 1, accent: false, o: 0.22, dur: 8, delay: 0.2 },
  { x: 380, y: 30, r: 1, accent: false, o: 0.25, dur: 7.2, delay: 2.4 },
];
---

<section class="field-region" aria-label="Constelação Cultiv — o mapa do Perfil de Voz">
  <div class="field-halo" aria-hidden="true"></div>

  <div class="viewport" data-viewport>
    <div class="fieldbox" data-fieldbox>
      <div class="drift">
        <svg class="edges" viewBox="0 0 600 800" preserveAspectRatio="none" aria-hidden="true">
          {
            DUST.map((d) => (
              <circle
                cx={d.x}
                cy={d.y}
                r={d.r}
                fill={d.accent ? "var(--accent)" : "currentColor"}
                opacity={d.o}
                style={`animation:floatDust ${d.dur}s ${d.delay}s ease-in-out infinite;`}
              />
            ))
          }
          {
            EDGES.map(([a, b, base]) => {
              const na = nodeById(a);
              const nb = nodeById(b);
              return (
                <g class="edge" data-a={a} data-b={b} style={`--eop:${base};`}>
                  <line class="edge-base" x1={na.x} y1={na.y} x2={nb.x} y2={nb.y} />
                  <line
                    class="edge-hi"
                    x1={na.x}
                    y1={na.y}
                    x2={nb.x}
                    y2={nb.y}
                    pathLength="1"
                    stroke-linecap="round"
                  />
                </g>
              );
            })
          }
        </svg>

        {
          NODES.map((n, i) => (
            <NodeStar node={n} index={i} selected={initial?.id === n.id} related={isRelated(n.id)} />
          ))
        }
      </div>
    </div>
  </div>

  <div class="legend" aria-hidden="true">
    <div class="legend-keys">
      <span class="key"
        ><span class="key-dot accent"></span>PERFIL DE VOZ · como a Cultiv aprende você</span
      >
      <span class="key dim"><span class="key-dot"></span>GERAÇÃO · como a sua voz é usada</span>
    </div>
    <span class="hint" data-hint>clique em uma estrela para explorar</span>
  </div>

  <slot />
</section>
