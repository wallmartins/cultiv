---
// Moldura comum dos overlays de jornada (Demo, Planos): cabeçalho com
// kicker/título/subtítulo + fechar, corpo via slot. O fechar é um link real
// para "/" (funciona sem JS); o script intercepta para fechar in-place.
interface Props {
  id: string;
  kicker: string;
  title: string;
  sub: string;
  open?: boolean;
  closeLabel: string;
}
const { id, kicker, title, sub, open = false, closeLabel } = Astro.props;
---

<div class="overlay" data-overlay={id} hidden={!open}>
  <div class="overlay-head">
    <div>
      <span class="kicker">{kicker}</span>
      <h2>{title}</h2>
      <p class="overlay-sub">{sub}</p>
    </div>
    <a class="close" href="/" data-close-overlay aria-label={closeLabel}>×</a>
  </div>
  <slot />
</div>
