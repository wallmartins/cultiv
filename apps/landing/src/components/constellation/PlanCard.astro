---
// Card de um plano — puro: recebe o plano e o índice (delay do popIn).
// Renderiza o estado padrão (BRL · mensal) e embute a matriz de preços +
// ambos os hrefs (mensal/anual) em data-attrs; os toggles do PlansOverlay
// reescrevem preço, aviso e CTA no cliente. Sem JS, fica em BRL mensal.
import { planUrl } from "../../config";
import type { Plan } from "../../data/constellation";

interface Props {
  plan: Plan;
  index: number;
}
const { plan: p, index } = Astro.props;
const base = p.prices.brl.monthly;
---

<article
  class:list={["plan", { featured: p.featured }]}
  style={`--pi:${index};`}
  data-plan
  data-prices={JSON.stringify(p.prices)}
>
  {p.featured && <span class="plan-badge">Mais escolhido</span>}
  <div>
    <h3>{p.name}</h3>
    <p class="plan-tag">{p.tag}</p>
  </div>
  <div class="plan-price">
    <span class="amount" data-plan-amount>{base.amount}</span>
    <span class="per mono" data-plan-per>{base.per}</span>
  </div>
  <p class="plan-note" data-plan-note hidden>{base.note}</p>
  <ul>
    {
      p.features.map((f) => (
        <li>
          <span class="li-dot" aria-hidden="true" />
          <span>{f}</span>
        </li>
      ))
    }
  </ul>
  <a
    class:list={["btn", "wide", p.featured ? "solid" : "ghost"]}
    href={planUrl(p.id, "monthly")}
    data-plan-cta
    data-href-monthly={planUrl(p.id, "monthly")}
    data-href-annual={planUrl(p.id, "annual")}
  >
    {p.btn}
  </a>
</article>
