# Waitlist + canonical site URL (SEO, OG)
SITE_URL=http://localhost:3000

# Backend Public API Surface (local dev — web stays on 3000)
VITE_API_BASE_URL=http://localhost:3001

# Auth0 (Authenticated Workspace) — domain is host only, no https://
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-spa-client-id
# Must match an API Identifier in Auth0 Dashboard → Applications → APIs (exact string)
VITE_AUTH0_AUDIENCE=https://api.cultiv.app

# Waitlist rate limit (required in production on Vercel — can share backend Redis)
REDIS_URL=redis://localhost:6379

# Loops (server-only — set in Vercel dashboard, not VITE_*)
# LOOPS_API_KEY=
# LOOPS_WAITLIST_ID=
