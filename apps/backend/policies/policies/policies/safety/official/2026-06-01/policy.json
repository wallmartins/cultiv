{
  "policyVersion": "2026-06-01",
  "lifecycle": "active",
  "unknownInputOutcome": "block",
  "evidenceBoundaries": [
    "input",
    "scope",
    "output",
    "consent",
    "override"
  ],
  "families": [
    {
      "family": "input",
      "defaultOutcome": "block",
      "allowedOutcomes": ["approve", "sanitize", "quarantine", "block"],
      "overrideability": "one_shot",
      "evidenceBoundary": "input",
      "detectorAdapters": ["instruction-override-classifier", "markup-sanitizer"],
      "nonOverridableCategories": ["security_sensitive_data", "llm_prohibited_data", "operational_data"]
    },
    {
      "family": "imported_context",
      "defaultOutcome": "block",
      "allowedOutcomes": ["approve", "sanitize", "quarantine", "block"],
      "overrideability": "one_shot",
      "evidenceBoundary": "input",
      "detectorAdapters": ["instruction-override-classifier", "markup-sanitizer", "sensitive-data-scanner"],
      "nonOverridableCategories": ["security_sensitive_data", "llm_prohibited_data", "operational_data"]
    },
    {
      "family": "step_scope",
      "defaultOutcome": "block",
      "allowedOutcomes": ["approve", "block"],
      "overrideability": "never",
      "evidenceBoundary": "scope",
      "detectorAdapters": []
    },
    {
      "family": "consent",
      "defaultOutcome": "block",
      "allowedOutcomes": ["approve", "block", "revoke"],
      "overrideability": "never",
      "evidenceBoundary": "consent",
      "detectorAdapters": []
    },
    {
      "family": "output_release",
      "defaultOutcome": "block",
      "allowedOutcomes": ["approve", "sanitize", "block", "require_override"],
      "overrideability": "one_shot",
      "evidenceBoundary": "output",
      "detectorAdapters": ["sensitive-data-scanner", "unsafe-code-scanner"],
      "nonOverridableCategories": ["security_sensitive_data", "llm_prohibited_data", "operational_data"]
    },
    {
      "family": "policy_evidence",
      "defaultOutcome": "approve",
      "allowedOutcomes": ["approve", "block"],
      "overrideability": "never",
      "evidenceBoundary": "output",
      "detectorAdapters": []
    },
    {
      "family": "operational_override",
      "defaultOutcome": "require_override",
      "allowedOutcomes": ["approve", "block", "require_override"],
      "overrideability": "time_limited",
      "evidenceBoundary": "override",
      "detectorAdapters": [],
      "maxOverrideWindowMinutes": 30
    }
  ],
  "classifications": [
    {
      "category": "ordinary_generation_input",
      "defaultOutcome": "approve",
      "minimizationRequired": true,
      "description": "Ordinary briefing and generation input that still requires backend-owned validation and minimization."
    },
    {
      "category": "imported_context_out_of_scope",
      "defaultOutcome": "block",
      "minimizationRequired": true,
      "description": "Imported context that exceeds launch scope such as oversized payloads or unsupported richer formats."
    },
    {
      "category": "voice_training_input",
      "defaultOutcome": "block",
      "minimizationRequired": true,
      "description": "Voice-example material that requires explicit consent and stronger storage protection."
    },
    {
      "category": "personal_data",
      "defaultOutcome": "sanitize",
      "minimizationRequired": true,
      "description": "Personal data that should be minimized before model use whenever possible."
    },
    {
      "category": "customer_confidential_data",
      "defaultOutcome": "quarantine",
      "minimizationRequired": true,
      "description": "Customer-confidential content that requires stronger handling than ordinary generation input."
    },
    {
      "category": "operational_data",
      "defaultOutcome": "block",
      "minimizationRequired": true,
      "description": "Internal operational instructions or context that must not flow into public generation paths."
    },
    {
      "category": "security_sensitive_data",
      "defaultOutcome": "block",
      "minimizationRequired": true,
      "description": "Security-sensitive content such as credentials or defensive operational detail."
    },
    {
      "category": "llm_prohibited_data",
      "defaultOutcome": "block",
      "minimizationRequired": true,
      "description": "Content categories that are prohibited from model use and must fail closed."
    }
  ],
  "detectorAdapters": [
    {
      "id": "instruction-override-classifier",
      "kind": "classifier",
      "optional": true,
      "boundaries": ["input", "override"]
    },
    {
      "id": "markup-sanitizer",
      "kind": "scanner",
      "optional": true,
      "boundaries": ["input"]
    },
    {
      "id": "sensitive-data-scanner",
      "kind": "scanner",
      "optional": true,
      "boundaries": ["input", "output", "consent"]
    },
    {
      "id": "unsafe-code-scanner",
      "kind": "heuristic",
      "optional": true,
      "boundaries": ["output"]
    }
  ]
}
