{
  "policyVersion": "2026-04-01",
  "routingProfiles": [
    {
      "id": "default-llm",
      "preferredAttempts": [
        { "provider": "anthropic", "model": "claude-3-5-sonnet-latest", "timeoutMs": 12000 }
      ],
      "fallbackAttempts": [
        { "provider": "openai", "model": "gpt-4.1", "timeoutMs": 12000 },
        { "provider": "gemini", "model": "gemini-1.5-pro", "timeoutMs": 12000 },
        { "provider": "deepseek", "model": "deepseek-chat", "timeoutMs": 12000 },
        { "provider": "openai", "model": "gpt-4o-mini", "timeoutMs": 12000 }
      ],
      "operationalConstraints": {
        "fallbackOn": ["transport_error", "timeout", "provider_unavailable", "invalid_response"]
      }
    },
    {
      "id": "premium-llm",
      "preferredAttempts": [
        { "provider": "anthropic", "model": "claude-3-7-sonnet-latest", "timeoutMs": 15000 }
      ],
      "fallbackAttempts": [
        { "provider": "openai", "model": "gpt-4.1", "timeoutMs": 15000 },
        { "provider": "gemini", "model": "gemini-1.5-pro", "timeoutMs": 15000 },
        { "provider": "deepseek", "model": "deepseek-reasoner", "timeoutMs": 15000 },
        { "provider": "openai", "model": "gpt-4o-mini", "timeoutMs": 15000 }
      ],
      "operationalConstraints": {
        "fallbackOn": ["transport_error", "timeout", "provider_unavailable", "invalid_response"]
      }
    }
  ],
  "contentTypes": [
    { "id": "long-form-blog", "label": "Long Form Blog", "defaultLanguage": "pt-BR", "pipelineType": "long-form-blog" },
    { "id": "validation-post", "label": "Validation Post", "defaultLanguage": "pt-BR", "pipelineType": "validation-post" },
    { "id": "architecture-post", "label": "Architecture Post", "defaultLanguage": "pt-BR", "pipelineType": "architecture-post" },
    { "id": "linkedin-post", "label": "LinkedIn Post", "defaultLanguage": "pt-BR", "pipelineType": "linkedin-post" },
    { "id": "twitter-thread", "label": "Twitter Thread", "defaultLanguage": "pt-BR", "pipelineType": "twitter-thread" },
    { "id": "newsletter", "label": "Newsletter", "defaultLanguage": "pt-BR", "pipelineType": "newsletter" }
  ],
  "pipelines": [
    {
      "pipelineType": "long-form-blog",
      "contentType": "long-form-blog",
      "defaultLanguage": "pt-BR",
      "defaultQualityMode": "strict",
      "steps": [
        { "name": "research", "skill": "research", "execution": "local" },
        { "name": "outline", "skill": "outline", "execution": "local" },
        { "name": "draft", "skill": "draft", "execution": "llm", "routingProfile": "premium-llm" },
        { "name": "refine", "skill": "refine", "execution": "llm", "routingProfile": "premium-llm" },
        { "name": "finalize", "skill": "publish", "execution": "local" }
      ]
    },
    {
      "pipelineType": "validation-post",
      "contentType": "validation-post",
      "defaultLanguage": "pt-BR",
      "defaultQualityMode": "balanced",
      "steps": [
        { "name": "analyze", "skill": "analyze", "execution": "local" },
        { "name": "draft", "skill": "draft", "execution": "llm", "routingProfile": "default-llm" },
        { "name": "refine", "skill": "refine", "execution": "llm", "routingProfile": "default-llm" }
      ]
    },
    {
      "pipelineType": "architecture-post",
      "contentType": "architecture-post",
      "defaultLanguage": "pt-BR",
      "defaultQualityMode": "strict",
      "steps": [
        { "name": "analyze", "skill": "analyze", "execution": "local" },
        { "name": "structure", "skill": "structure", "execution": "llm", "routingProfile": "premium-llm", "override": { "from": "local", "to": "llm", "reason": "architecture framing needs model synthesis" } },
        { "name": "draft", "skill": "draft", "execution": "llm", "routingProfile": "premium-llm" },
        { "name": "refine", "skill": "refine", "execution": "llm", "routingProfile": "premium-llm" }
      ]
    },
    {
      "pipelineType": "linkedin-post",
      "contentType": "linkedin-post",
      "defaultLanguage": "pt-BR",
      "defaultQualityMode": "balanced",
      "steps": [
        { "name": "hook", "skill": "hook", "execution": "llm", "routingProfile": "default-llm" },
        { "name": "draft", "skill": "draft", "execution": "llm", "routingProfile": "default-llm" },
        { "name": "refine", "skill": "refine", "execution": "llm", "routingProfile": "default-llm" }
      ]
    },
    {
      "pipelineType": "twitter-thread",
      "contentType": "twitter-thread",
      "defaultLanguage": "pt-BR",
      "defaultQualityMode": "fast",
      "steps": [
        { "name": "hook", "skill": "hook", "execution": "llm", "routingProfile": "default-llm" },
        { "name": "expand", "skill": "draft", "execution": "llm", "routingProfile": "default-llm" },
        { "name": "tighten", "skill": "refine", "execution": "llm", "routingProfile": "default-llm" }
      ]
    },
    {
      "pipelineType": "newsletter",
      "contentType": "newsletter",
      "defaultLanguage": "pt-BR",
      "defaultQualityMode": "balanced",
      "steps": [
        { "name": "outline", "skill": "outline", "execution": "local" },
        { "name": "draft", "skill": "draft", "execution": "llm", "routingProfile": "default-llm" },
        { "name": "refine", "skill": "refine", "execution": "llm", "routingProfile": "default-llm" },
        { "name": "finalize", "skill": "publish", "execution": "local" }
      ]
    }
  ]
}
