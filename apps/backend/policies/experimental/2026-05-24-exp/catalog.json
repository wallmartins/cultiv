      ],
      "fallbackAttempts": [
        { "provider": "openai", "model": "gpt-4.1", "timeoutMs": 12000 },
        { "provider": "gemini", "model": "gemini-1.5-pro", "timeoutMs": 12000 },
        { "provider": "deepseek", "model": "deepseek-chat", "timeoutMs": 12000 },
