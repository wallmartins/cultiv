    "billing:export-jobs": "node dist/scripts/export-calibration-jobs.js",
    "billing:calibration-sweep": "node dist/scripts/run-calibration-sweep.js",
    "billing:analyze-option-b": "node dist/scripts/analyze-calibration-option-b.js",
    "rotate-voice-key": "node dist/cli/rotate-voice-protection-key.js",
