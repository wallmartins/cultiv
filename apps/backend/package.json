    "./execution": "./src/execution.ts",
    "./execution/quality": "./src/execution/quality/index.ts",
    "./job-store": "./src/jobs/job-store.ts",
    "./memory": "./src/memory/memory.ts",
    "./product": "./src/product.ts",
    "./worker": "./src/jobs/worker.ts",
    "./worker-job": "./src/jobs/worker-job.ts",
    "./package.json": "./package.json"
