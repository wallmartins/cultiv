{
  "name": "@my-ai-orchestrator/backend",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/cli/main.ts",
    "start": "node dist/cli/main.js",
