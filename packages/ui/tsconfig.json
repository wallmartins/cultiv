{
  "extends": "../config/tsconfig/base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    "jsx": "react-jsx",
    // Base is ES2022-only (shared with non-DOM packages); this package renders real form
    // controls (e.g. RailSearch's <input onChange>) that need HTMLInputElement/EventTarget.
    "lib": ["ES2022", "DOM"]
  },
  "include": ["src/**/*", "app/**/*"],
  "exclude": ["dist", "node_modules"]
}
