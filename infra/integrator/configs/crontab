# Cultiv — VPS Cron Configuration
# =============================================================================
# Adicione estas linhas ao crontab do usuário cultiv:
#   crontab -e
# =============================================================================

# Health check a cada 2 minutos
*/2 * * * * /home/cultiv/cultiv/scripts/health-check.sh >> /home/cultiv/cultiv/logs/health-check.log 2>&1

# Métricas a cada 1 minuto
* * * * * /home/cultiv/cultiv/scripts/metrics-collector.sh >> /home/cultiv/cultiv/logs/metrics.log 2>&1

# Backup diário às 03:00 UTC
0 3 * * * /home/cultiv/cultiv/scripts/backup.sh >> /home/cultiv/cultiv/logs/backup.log 2>&1

# Verificação de backup semanal (domingo às 04:00)
0 4 * * 0 /home/cultiv/cultiv/scripts/verify-backup.sh >> /home/cultiv/cultiv/logs/verify-backup.log 2>&1

# Resumo de logs diário às 08:00 UTC
0 8 * * * /home/cultiv/cultiv/scripts/log-summary.sh >> /home/cultiv/cultiv/logs/log-summary.log 2>&1

# Sweep de fim de trial/ciclo diário às 02:00 UTC (ADR 0006 — materializa trialing/canceled -> lapsed
# via min(pool, dia 7) e dispara avisos de fim de janela). O paywall já funciona no lazy-clock; isto
# mantém a coluna de status coerente. Confirme o path do app (/home/cultiv/cultiv) e DATABASE_URL no .env.
0 2 * * * /home/cultiv/cultiv/scripts/billing-lifecycle-sweep.sh >> /home/cultiv/cultiv/logs/billing-sweep.log 2>&1
