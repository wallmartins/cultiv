# Cultiv — Production Environment Variables
# =============================================================================
# Copie este arquivo para .env e preencha todos os valores.
# NUNCA commite .env no repositório.
# =============================================================================

# App
NODE_ENV=production
HOST=127.0.0.1
PORT=3001
SERVICE_NAME=cultiv
APP_VERSION=0.1.0
EXECUTION_MODE=async
QUALITY_MODE=balanced
DEFAULT_LANGUAGE=pt-BR

# Database
DATABASE_URL=postgresql://cultiv:PASSWORD@127.0.0.1:5432/cultiv
REDIS_URL=redis://127.0.0.1:6379

# Auth0
AUTH_ISSUER_URL=https://seu-tenant.us.auth0.com/
AUTH_AUDIENCE=https://api.cultiv.app
AUTH_JWKS_URL=https://seu-tenant.us.auth0.com/.well-known/jwks.json

# Auth0 Management API (M2M) — exigido pela exclusão de conta (LGPD): sem estas vars o evento
# account.auth0-delete fica em retry infinito no outbox e a identidade nunca é apagada no Auth0.
AUTH0_MANAGEMENT_DOMAIN=seu-tenant.us.auth0.com
AUTH0_MANAGEMENT_CLIENT_ID=...
AUTH0_MANAGEMENT_CLIENT_SECRET=...
AUTH0_MANAGEMENT_AUDIENCE=https://seu-tenant.us.auth0.com/api/v2/

# AI Providers — a policy oficial ativa roteia para gemini + groq; as duas chaves são
# obrigatórias e o boot falha sem elas. As demais só habilitam providers fora da policy.
GEMINI_API_KEY=...
GROQ_API_KEY=...
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Security
BACKEND_TRUST_PROXY=true
VOICE_DATA_PROTECTION_KEY=32-char-min-random-key
CORS_ALLOWED_ORIGINS=https://www.cultiv.app,https://cultiv.app

# Monitoring
OUTBOX_RELAY_INTERVAL_MS=1000
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_MS=60000

# Billing (dev bootstrap only — runtime entitlements come from the database per user)
BILLING_USER_ID=default
# Optional: seeds a subscription cycle for BILLING_USER_ID on startup (in-memory dev only; ignored when DATABASE_URL is set)
# Deixe vazio: o plano "free" não existe mais no catálogo (ADR 0006 — trial de 7d, sem plano free).
BILLING_PLAN_ID=

# Policies
AI_POLICY_MANIFEST_PATH=/home/cultiv/cultiv/app/apps/backend/policies/official/manifest.json
SAFETY_POLICY_MANIFEST_PATH=/home/cultiv/cultiv/app/apps/backend/policies/safety/official/manifest.json

# Notifications
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Backup — Cloudflare R2
# See: infra/integrator/docs/runbooks/cloudflare-r2-setup.md
R2_BUCKET_NAME=cultiv-backups
R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<r2-api-token-key>
R2_SECRET_ACCESS_KEY=<r2-api-token-secret>

# Cloudflare Tunnel (optional, for reference)
# TUNNEL_ID=<tunnel-id>  # Not used by the app, but useful for ops
# TUNNEL_HOSTNAME=api.cultiv.app
